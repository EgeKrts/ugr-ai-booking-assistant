# Local LLM through Ollama (no API key needed). Pull the model first: ollama pull qwen3:8b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# DATASET_PATH is used by inspect-dataset; other settings are for later steps.
DATABASE_URL=sqlite:///data/booking.sqlite3
DATASET_PATH=data/private/dataset
LOG_LEVEL=INFO
